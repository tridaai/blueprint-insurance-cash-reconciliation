# Insurance Cash Reconciliation Agent — configuration
#
# A real model is the lead profile. Set ONE provider below and the
# remittance reader / allocation proposer use it; with nothing set the
# pipeline runs on the labelled offline fallback (deterministic text-layer
# extraction — fine for the synthetic set, not a substitute for a model on
# free-form remittance advices).

# --- OpenAI-compatible endpoint (covers OpenAI, NVIDIA NIM, vLLM, ...) ---
# Hosted NVIDIA NIM:  OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# Self-hosted NIM:     OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Ollama (local) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Which reader backend: auto (first configured provider), openai,
# anthropic, ollama, or offline.
# LLM_BACKEND=auto

# --- Stores: switching is an env change only ---
# Local default (zero setup): with DATABASE_URL unset, records,
# checkpoints and document embeddings persist to a single SQLite file.
# SQLITE_PATH=data/cashrecon.db
#
# Production (docker compose sets these): set DATABASE_URL and the
# same code runs on PostgreSQL + pgvector instead.
# DATABASE_URL=postgresql://cashrecon:cashrecon@postgres:5432/cashrecon
# S3_BUCKET=remittance-documents
# S3_ENDPOINT_URL=http://minio:8333
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_REGION=us-east-1

# --- Policy thresholds (defaults shown) ---
# AUTO_APPLY_THRESHOLD=500.00     exact T1 matches at or below this may be
#                                 marked auto-appliable (still reported)
# WRITE_OFF_SINGLE_LIMIT=250.00   delta write-offs above this need a
#                                 second, different approver
# STALE_SUSPENSE_DAYS=30          unapplied cash older than this is stale
# SUSPENSE_DISPOSITION_MIN_AGE_DAYS=90
#                                 unapplied cash at or past this age may be
#                                 proposed for disposition (write-off to
#                                 income, or escheat review) — approval
#                                 always takes two approvers
# NETTING_TOLERANCE=0.01

# --- Gate webhooks (unset = disabled; /readiness reports the state) ---
# Pack assembled / approved / rejected and return-recorded events are
# POSTed as small JSON to this URL. One retry; a failed delivery is
# audited as webhook_failed and never blocks the gate act.
# CASH_RECON_WEBHOOK_URL=

# --- Checkpoint retention (defaults shown) ---
# The day-run graph's LangGraph checkpoints accumulate with every
# run; the governed prune (cash-recon checkpoints prune) keeps the
# newest per thread and lets older ones go. Pruning is an explicit
# operator act; the startup hook below is the only automatic path,
# and it is off unless set.
# CHECKPOINT_KEEP_PER_THREAD=50   newest checkpoints kept per thread
# CHECKPOINT_MAX_AGE_DAYS=30       kept checkpoints older than this go
#                                  too (never a thread's newest)
# CHECKPOINT_PRUNE_ON_STARTUP=    set to 1 to prune once at API startup

# Optional shared secret for the API (unset = open, local demos only).
# API_KEY=
